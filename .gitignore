# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# built privacy-policy page (see .github/workflows/privacy-policy.yml)
_site/

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Supabase CLI local state: which project this checkout is linked to, plus
# cached server versions. Machine-local, and it changes per developer.
supabase/.temp/
supabase/.branches/

# env files
.env*
!.env.example

# editor swap files
*.swp
*.swo
*.swn
