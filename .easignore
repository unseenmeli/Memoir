# Files excluded from the archive uploaded to EAS Build.
#
# IMPORTANT: EAS prioritizes this file OVER .gitignore rather than merging the
# two — the moment this file exists, none of .gitignore's rules apply. So the
# first block below is a copy of .gitignore and has to stay in step with it;
# everything genuinely new to the build archive is in the second block.

# ---------------------------------------------------------------------------
# Mirror of .gitignore — keep in step.
# ---------------------------------------------------------------------------
node_modules/

.expo/
dist/
web-build/
expo-env.d.ts

.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

.metro-health-check*

npm-debug.*
yarn-debug.*
yarn-error.*

.DS_Store
*.pem

*.tsbuildinfo

# Built privacy-policy page.
_site/

# Generated by prebuild during the build itself.
/ios
/android

# Secrets. Production values are injected from eas.json's `env` block.
.env*
!.env.example

*.swp
*.swo
*.swn

# ---------------------------------------------------------------------------
# Additionally excluded from builds. None of this is reachable from the Metro
# entry point, so dropping it only shrinks the upload — it cannot change what
# the app bundles.
# ---------------------------------------------------------------------------

# Design reference component. Not imported by app/ or src/, and outside
# tailwind.config.js's content globs.
designexample/

# Backend. Deployed with the Supabase CLI, never compiled into the app.
supabase/

# Docs, CI and agent tooling. None of it is compiled into the app.
*.md
.github/
scripts/
.agents/
.claude/
skills-lock.json
