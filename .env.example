# Copy to .env and fill in from Project Settings → API Keys in the Supabase
# dashboard.
#
# Anything prefixed EXPO_PUBLIC_ is compiled into the shipped bundle and can be
# read out of the binary. Only the publishable key belongs here — it is meant
# to be public, and row level security is what actually protects the data. The
# secret key goes in supabase/.env (see supabase/.env.example) and must never
# be given an EXPO_PUBLIC_ prefix.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# Cloudinary credentials do NOT belong in this file. Pin photos are uploaded
# with a signature minted by the `cloudinary-sign` Edge Function, so the app
# never holds a Cloudinary key of any kind. See supabase/.env.example.
