# Copy to supabase/.env for local Edge Function development:
#
#   supabase functions serve --env-file supabase/.env
#
# On the hosted platform all of these are auto-provisioned — a deployed
# function needs no configuration.
#
# SUPABASE_SECRET_KEY bypasses row level security entirely. Treat it like a
# root password: never prefix it with EXPO_PUBLIC_, and never reference it
# from anything under src/.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
SUPABASE_SECRET_KEY=sb_secret_your-key-here
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Cloudinary. Pin photos live there rather than in Supabase Storage — see the
# migration that added `pin_photos.provider`.
#
# CLOUDINARY_API_SECRET can sign an upload to any path in the account and a
# delivery URL for any asset in it. It is the entire security boundary for
# photos: never give it an EXPO_PUBLIC_ prefix, and never reference it from
# anything under src/. Only supabase/functions/ ever reads it.
#
# On the hosted platform these are NOT auto-provisioned like the Supabase ones.
# Set them once with:
#
#   supabase secrets set --env-file supabase/.env
#
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
